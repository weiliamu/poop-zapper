{
  "manifest_version": 3,
  "name": "Poop Zapper",
  "version": "1.0",
  "background": {
    "service_worker": "background.js"
  },
  "description": "This extension removes poop websites from your search engine results.",

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "Poop Zapper",
    "default_icon": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
  },
  
  "permissions": ["storage", "activeTab", "scripting", "contextMenus", "tabs", "webNavigation"],
  
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  
  "host_permissions": [
    "<all_urls>"
  ],
  

  "content_scripts": [
    {
      "matches": [
        "*://*.google.com/*",
        "*://*.bing.com/*",
        "*://*.duckduckgo.com/*"
      ],
      "js": ["poopzapper.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}